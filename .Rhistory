ggplot(Final_Home_Student, aes(x = Math_Percent_Correct, fill = interaction(Country, Sex))) +
geom_histogram(bins = 30, color = "black", alpha = 0.7) +
labs(title = "Distribution of Math Scores", x = "Math Score (%)", y = "Frequency") +
facet_grid(rows = vars(Country), cols = vars(Sex)) +
scale_fill_brewer(palette = "Blues") +  # Uses a blue gradient
theme_bw()
#| label: fig-dist-of-math-score-country-sex-home-support
#| layout-ncol: 2
#| layout-nrow: 2
#| fig-cap: Boxplots of the the Distribution of Scores by Country, Sex and Home Support
#| fig-subcap:
#| - "Boxplots of the the Distribution of Scores by Country"
#| - "Boxplots of the the Distribution of Scores by Sex "
#| - "Boxplots of the the Distribution of Scores by Country and Sex"
#| - Boxplots of the the Distribution of Scores by Home Support
#
#frames <- layout( matrix(c(1,2,3,4), nrow=2, byrow=TRUE) )
## Visualizing Math Scores by Country
ggplot(Final_Home_Student, aes(x = Country, y = Math_Percent_Correct, fill = Country)) +
geom_boxplot() +
labs(title = "Math Scores by Country", x = "Country", y = "Math Score (%)") +
scale_fill_manual(values = c("#9AD1D0", "#2C5985")) +
theme_bw()
## Visualizing Math Scores by Sex
ggplot(Final_Home_Student, aes(x = Sex, y = Math_Percent_Correct, fill = Sex)) +
geom_boxplot() +
labs(title = "Math Scores by Sex", x = "Sex", y = "Math Score (%)") +
scale_fill_manual(breaks = Final_Home_Student$Sex,
values = c ("#BCE4D8", "#2D5E88"))+ theme_bw()
## Visualizing Math Scores by COuntry and Sex
ggplot(Final_Home_Student, aes(x = Country, y = Math_Percent_Correct, fill = Sex)) +
geom_boxplot() +
labs(title = "Math Scores by Country and Sex", x = "Country", y = "Math Score (%)") +
scale_fill_brewer("blues")+ theme_bw()
## Visualizing Math Scores by Home Support
ggplot(Final_Home_Student, aes(x = Number_of_Home_Study_Supports, y = Math_Percent_Correct, fill = Number_of_Home_Study_Supports)) +
geom_boxplot() +
labs(title = "Math Scores by Number of Home Spport", x = "Sex", y = "Math Score (%)") +
scale_fill_brewer("blues") +
theme(axis.text.x = element_text(angle = 45, hjust = 1))+ theme_bw()
#| label: fig-Correlations
#| fig-cap: Correlation Heatmap for Student-Level Analysis
## Subsetting Muneric Variables only
std_cor_data <- Final_Home_Student |> dplyr::select(Age:Confident_in_Math, Math_Percent_Correct)
## Correlation Matrix
std_cor <- round(cor(std_cor_data), 1)
## Matrix of Correlation P-Values
p_std_cor <- cor_pmat(std_cor_data)
## Correlation Plot
ggcorrplot( std_cor, type = "upper", outline.col = "black", ggtheme = ggplot2::theme_minimal, colors = c("#6D9EC1", "white", "#E46726"), lab = TRUE)
#| label: tbl-Initial-regression-for-student-data
#| tbl-cap: Student-Level Regression Analysis
#| tbl-subcap:
#| - Student Level Regression Coefficients
#| - Student Level Model Summary Statistics
#| - Variance Inflation Factors
std_reg_initial <- lm(Math_Percent_Correct ~ . - Student_ID, data = Final_Home_Student)
std_stepwise <- step(std_reg_initial, direction = "both", trace = 0)
tidy_std_stepwise <- tidy(std_stepwise)
std_stepwise_summary <- glance(std_stepwise)
tidy_std_stepwise |>
kable(digits = 3, caption = "Student Level Analysis Regression Coefficients") |>
kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
std_stepwise_summary |>
kable(digits = 3, caption = "Student Level Analysis Model Summary Statistics") |>
kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
#summary(std_stepwise)
VIF(std_stepwise) |>
kable(digits = 3, caption = "Student Level Analysis Variance Inflation Factors") |> kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
#| label: fig-residual-std_reg_initial
#| tbl-cap: Residual Plots for the First Regression Model
par(mfrow=c(2, 2)) # Set the plot window to display a 2x2 matrix of plots.
plot(std_stepwise)
options(ggeffects_margin = "marginalmeans")
std_pred <- estimate_means(std_stepwise, by = c("Sex", "Country"))
std_pred
options(ggeffects_margin = "empirical")
std_pred <- estimate_means(std_stepwise, by = c("Sex", "Country"))
std_pred
plot(std_pred)
plot(std_pred)
std_pred |>
kable(digits = 3, caption = "Student Level Analysis Variance Inflation Factors") |> kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
#| label: fig-Differences-in-Differences-fiqures
## Visulaizing the differences in the average predictions for different country and sex combinations.
plot(std_pred)
#| label: tbl-Differences-in-Differences-tables
#| tbl-cap: Estimated Marginal Means of Predicted Math Scores by Sex and Country
## Estimating the differences in the average predictions for different country and sex combinations.
std_pred <- estimate_means(std_stepwise, by = c("Sex", "Country"))
std_pred |>
kable(digits = 3, caption = "Student Level Analysis Variance Inflation Factors") |> kable_styling(bootstrap_options = c("striped", "hover", "condensed"))
## Answers what is the predicted (average) value of math percent at meaningful levels or values of my focal terms for an ‘average’ observation in my data?”. It refers to randomly picking a subject of your sample and the result you get on average.
#| label: fig-Differences-in-Differences-fiqures
#| fig-cap: Estimated Marginal Means of Predicted Math Scores by Sex and Country
## Visulaizing the differences in the average predictions for different country and sex combinations.
plot(std_pred)
## Testing if these differences are significant
std_contrast <- estimate_contrasts(std_stepwise, contrast = c("Sex", "Country"))
